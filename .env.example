# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# PostgreSQL. Local: base PGlite con `bun run db:local` (puerto 5433).
# Producción: cadena de conexión de Neon (con ?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"

# Solo en local con PGlite: base "sombra" vacía que levanta `bun run db:local` (puerto 5435)
# para que `bun run db:migrate` funcione. Quítala si DATABASE_URL apunta a Neon.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5435/postgres?sslmode=disable"

# Secreto de Auth.js para firmar sesiones. Genera uno con:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Secreto HMAC para firmar los QR de los tickets (Fase 3). Genera uno igual que AUTH_SECRET.
QR_SECRET=""

# Factor de emisión del Sistema Eléctrico Nacional, en kg CO2 por kWh (= t CO2e/MWh).
# 0.444 es el FE-SEN 2024, el oficial vigente: aviso de SEMARNAT del 28 de febrero de 2025
# (https://www.gob.mx/cms/uploads/attachment/file/981194/aviso_fesen_2024.pdf). El de 2025 sigue
# en proceso y SEMARNAT pidió seguir usando el de 2024. Actualízalo si sale uno nuevo antes del piloto.
FE_SEN="0.444"

# Correo para dudas de privacidad y para pedir ver, corregir o borrar datos (aparece en /privacidad).
# Si se deja vacío, el aviso pide hacerlo con el equipo en el stand.
PRIVACY_CONTACT_EMAIL=""

# Contraseña de los tres usuarios demo que crea el seed (mínimo 8 caracteres).
# Usa una distinta y fuerte en producción.
SEED_DEMO_PASSWORD=""

# Solo en local con `bun run start` (modo producción). En Vercel no hace falta.
# AUTH_TRUST_HOST=true
