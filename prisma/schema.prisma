// Esquema de EcoPuntos. Basado en SPEC.md ("Modelo de datos") con estos ajustes
// aprobados: Rule usa una clave de texto, Bill es único por
// [kind, serviceNumber, periodStart] y se agregaron relaciones e índices.
//
// REGLA DE ORO: el saldo NUNCA se guarda como campo. Es la suma de PointEntry.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum EntryType {
  PURCHASE
  BRING_CONTAINER
  RECYCLE
  BILL_REDUCTION
  CHALLENGE
  REDEEM
  DONATION
  ADJUSTMENT
}

enum EvidenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillKind {
  ELECTRICITY
  WATER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  entries        PointEntry[]
  bills          Bill[]         @relation("BillOwner")
  billsReviewed  Bill[]         @relation("BillReviewer")
  services       ServiceAccount[]
  salesOperated  Sale[]         @relation("SaleOperator")
  salesClaimed   Sale[]         @relation("SaleClaimedBy")
  recycleClaims  RecycleClaim[] @relation("RecycleOwner")
  recyclesReviewed RecycleClaim[] @relation("RecycleReviewer")
  redemptions    Redemption[]   @relation("RedemptionOwner")
  couponsUsed    Redemption[]   @relation("CouponUsedBy")
}

// Un número de servicio CFE o de agua pertenece a una sola cuenta.
model ServiceAccount {
  id     String   @id @default(cuid())
  kind   BillKind
  number String
  userId String
  user   User     @relation(fields: [userId], references: [id])

  @@unique([kind, number])
  @@index([userId])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  priceCents  Int
  bulk        Boolean @default(false) // granel o retornable
  local       Boolean @default(false)
  plasticFree Boolean @default(false)
  certified   Boolean @default(false)
  active      Boolean @default(true)
}

// Venta del stand; genera el QR firmado.
model Sale {
  id               String    @id @default(cuid())
  operatorId       String
  operator         User      @relation("SaleOperator", fields: [operatorId], references: [id])
  items            Json // [{productId, qty, priceCents, ecoScore}]
  totalCents       Int
  points           Int
  broughtContainer Boolean   @default(false)
  qrNonce          String    @unique
  expiresAt        DateTime
  claimedById      String?
  claimedBy        User?     @relation("SaleClaimedBy", fields: [claimedById], references: [id])
  claimedAt        DateTime?
  createdAt        DateTime  @default(now())
}

// Estado de un recibo. DRAFT solo existe aquí: el archivo ya se subió y el OCR
// ya lo leyó, pero el usuario todavía no confirma los datos.
enum BillStatus {
  DRAFT // subido; falta que el usuario confirme los datos
  PENDING // enviado; espera al operador
  APPROVED
  REJECTED // el usuario puede corregirlo y reenviarlo, o borrarlo
}

model Bill {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation("BillOwner", fields: [userId], references: [id])
  kind             BillKind
  // Datos confirmados por el usuario (vacíos mientras es borrador).
  serviceNumber    String?
  periodStart      DateTime?
  periodEnd        DateTime?
  consumption      Float? // kWh o m³
  // Lo que leyó el OCR: sirve para prellenar y para comparar con lo confirmado.
  ocrServiceNumber String?
  ocrPeriodStart   DateTime?
  ocrPeriodEnd     DateTime?
  ocrConsumption   Float?
  ocrConfidence    Float? // 0 a 1
  fileHash         String     @unique // SHA-256: el mismo archivo no se sube dos veces
  file             BillFile?
  // Sin OCR, OCR distinto en más de 10% o reducción mayor a 50% (SPEC.md).
  detailedReview   Boolean    @default(false)
  // Reducción diaria contra el recibo aprobado anterior, fijada al aprobar (retos de reducción).
  reductionPct     Float?
  status           BillStatus @default(DRAFT)
  reviewNote       String?
  reviewedById     String?
  reviewedBy       User?      @relation("BillReviewer", fields: [reviewedById], references: [id])
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime   @default(now())

  @@unique([kind, serviceNumber, periodStart]) // no se paga dos veces el mismo periodo
  @@index([status])
  @@index([userId])
}

// Foto o PDF del recibo, aparte para no cargar los bytes al listar recibos.
// Solo lo ven el dueño y los operadores; se borra al terminar el piloto.
model BillFile {
  billId   String @id
  bill     Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  mimeType String
  size     Int
  data     Bytes
}

model RecycleBin {
  id       String         @id @default(cuid())
  name     String
  location String
  code     String         @unique
  claims   RecycleClaim[]
}

model RecycleClaim {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation("RecycleOwner", fields: [userId], references: [id])
  binId           String
  bin             RecycleBin     @relation(fields: [binId], references: [id])
  pieces          Int // las que dijo el usuario
  confirmedPieces Int? // las que contó el operador; pagan con el límite semanal
  status          EvidenceStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?          @relation("RecycleReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@index([status])
  @@index([userId])
}

model PointEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      EntryType
  points    Int // positivo o negativo
  sourceId  String? // Sale, Bill, RecycleClaim, Redemption, "challengeId:userId"...
  impact    Json? // {kwh, m3, co2Kg, containers, pieces}
  createdAt DateTime  @default(now())

  @@unique([type, sourceId]) // una misma evidencia no paga dos veces
  @@index([userId, type, createdAt]) // saldo, historial y límites por periodo
}

// Valores ajustables del motor de puntos (src/lib/points/).
// key: PURCHASE_A | PURCHASE_B | PURCHASE_C | BRING_CONTAINER | RECYCLE |
//      BILL_REDUCTION | CHALLENGE
// limitPeriod: "day" | "week" | "bill"
model Rule {
  key         String  @id
  points      Int
  limitCount  Int?
  limitPeriod String?
}

model Challenge {
  id       String   @id @default(cuid())
  title    String
  metric   String // ej. "BRING_CONTAINER_count", "ELECTRICITY_reduction_pct"
  target   Float
  reward   Int      @default(100)
  startsAt DateTime
  endsAt   DateTime
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  cost        Int
  stock       Int
  isDonation  Boolean      @default(false)
  redemptions Redemption[]
}

model Redemption {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("RedemptionOwner", fields: [userId], references: [id])
  rewardId  String
  reward    Reward    @relation(fields: [rewardId], references: [id])
  code      String    @unique // cupón de un solo uso (ECO-XXXX-XXXX)
  usedAt    DateTime? // las donaciones se registran ya usadas
  usedById  String?
  usedBy    User?     @relation("CouponUsedBy", fields: [usedById], references: [id])
  createdAt DateTime  @default(now())

  @@index([userId])
}
